# ── 의존성 ────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.js

# ── 빌드 / 테스트 ─────────────────────────────────────────
/build
/dist
/coverage

# ── 환경 변수 ─────────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── 로그 ──────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── 에디터 / IDE ──────────────────────────────────────────
.idea/
.vscode/
*.iml

# ── OS ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ── 문서: 기획(README)만 저장소에 둔다 ────────────────────
# 설계 지침·진행 계획·현황 문서는 로컬에서만 관리한다.
*.md
!/README.md

# ── 학습 산출물: 모델 가중치는 저장소에 넣지 않는다 ───────
# 용량이 크고 재학습으로 대체되므로 릴리스나 별도 저장소로 배포한다.
*.onnx
*.pth
*.pt
*.tflite
*.h5
*.keras
*.task
*.pb
*.caffemodel

# ── 학습 데이터 / 중간 산출물 ─────────────────────────────
/dataset/
/processed_data/
/models/
*.npy
*.npz
*.pkl
*.tfrecord

# ── 노트북 체크포인트 ─────────────────────────────────────
.ipynb_checkpoints/

# ── 폰트 (라이선스 문제로 저장소에 두지 않는다) ───────────
/fonts/
